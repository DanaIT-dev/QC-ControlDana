{
  "name": "@sgr-registry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "tsx scripts/run-integration-tests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/lib-storage": "^3.1119.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@sgr-registry/config": "workspace:*",
    "@sgr-registry/contracts": "workspace:*",
    "@sgr-registry/database": "workspace:*",
    "@sgr-registry/domain": "workspace:*",
    "@sgr-registry/jobs": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.3",
    "fastify": "5.12.5",
    "image-size": "^2.0.3",
    "ioredis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@sgr-registry/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DanaIT-dev/QC-ControlDana/schemas/release-manifest.schema.json",
  "title": "QC-ControlDana amd64 release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseId",
    "sourceCommit",
    "sourceRepository",
    "createdAt",
    "targetEnvironment",
    "targetPlatform",
    "deployable",
    "mutableReferences",
    "images"
  ],
  "properties": {
    "releaseId": { "type": "string", "pattern": "^rc-[0-9]{8}-[0-9a-f]{7,12}$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceRepository": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "targetEnvironment": { "const": "staging" },
    "targetPlatform": { "const": "linux/amd64" },
    "deployable": { "type": "boolean" },
    "sharedRuntimeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "mutableReferences": { "type": "array", "maxItems": 0 },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageRole",
        "repository",
        "versionTag",
        "registryDigest",
        "platformDigest",
        "baseImageDigest",
        "sbomChecksum",
        "provenanceReference",
        "signatureReference",
        "openVexReference",
        "scanDatabaseUpdatedAt",
        "scanSummary"
      ],
      "properties": {
        "imageRole": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "versionTag": { "type": "string", "pattern": "^rc-[0-9]{8}-[0-9a-f]{7,12}$" },
        "registryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "platformDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "baseImageDigest": { "type": ["string", "null"] },
        "sbomChecksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "provenanceReference": { "type": "string" },
        "signatureReference": { "type": "string" },
        "openVexReference": { "type": "string" },
        "scanDatabaseUpdatedAt": { "type": "string" },
        "scanSummary": { "type": "object" },
        "command": { "type": "array", "items": { "type": "string" } },
        "user": { "type": "string" },
        "platform": { "const": "linux/amd64" },
        "ociRevision": { "type": "string" },
        "publishedPorts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

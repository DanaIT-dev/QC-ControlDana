generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActFormCode {
  S1
  S23
}

enum ActStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DefectItemStatus {
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  ADMIN
  SGR_MANAGER
  RESPONSIBLE_ENGINEER
  CONTRACTOR_ENGINEER
}

enum UserStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationRoleType {
  CUSTOMER
  LIABLE_CONTRACTOR
  ALTERNATIVE_CONTRACTOR
}

enum ProposalSlot {
  A
  B
  C
}

enum ProposalStatus {
  ACTIVE
  ARCHIVED
}

enum AuditSource {
  WEB
  SYSTEM
}

enum AttachmentStatus {
  UPLOADING
  PENDING_SCAN
  SCANNING
  READY
  REJECTED
  SCAN_FAILED
  ARCHIVED
}

enum AttachmentCategory {
  ACT_DOCUMENT
  ACT_SCAN
  DEFECT_PHOTO
  CLAIM_DOCUMENT
  THIRD_PARTY_DOCUMENT
  PROPOSAL_DOCUMENT
  OTHER
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  fullName            String
  email               String     @unique
  phone               String?
  passwordHash        String?
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  mustChangePassword  Boolean    @default(false)
  sessionVersion      Int        @default(1)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  role                UserRole
  status              UserStatus @default(ACTIVE)
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime?  @db.Timestamptz(3)

  objectAssignments     PropertyObjectEngineer[]
  defectItemAssignments DefectItemEngineer[]
  cancelledActs         Act[]                    @relation("ActCancelledBy")
  uploadedAttachments   Attachment[]             @relation("AttachmentUploadedBy")
  archivedAttachments   Attachment[]             @relation("AttachmentArchivedBy")
  auditLogs             AuditLog[]
  idempotencyRecords    IdempotencyRecord[]

  @@index([role, status])
  @@index([status, createdAt])
  @@map("users")
}

model PropertyObject {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  address        String
  commissionedAt DateTime? @db.Timestamptz(3)
  warrantyEndsAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  active         Boolean   @default(true)
  archivedAt     DateTime? @db.Timestamptz(3)
  version        Int       @default(1)

  engineers PropertyObjectEngineer[]
  acts      Act[]

  @@index([active, name])
  @@map("property_objects")
}

model PropertyObjectEngineer {
  id               String    @id @default(uuid()) @db.Uuid
  propertyObjectId String    @db.Uuid
  userId           String    @db.Uuid
  assignedAt       DateTime  @default(now()) @db.Timestamptz(3)
  unassignedAt     DateTime? @db.Timestamptz(3)

  propertyObject PropertyObject @relation(fields: [propertyObjectId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([propertyObjectId])
  @@index([userId])
  @@map("property_object_engineers")
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  officialName  String
  unp           String?
  postalAddress String
  email         String
  phone         String
  contactPerson String
  active        Boolean   @default(true)
  archivedAt    DateTime? @db.Timestamptz(3)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  roles        OrganizationRoleAssignment[]
  workTypes    OrganizationWorkType[]
  customerActs Act[]                          @relation("ActCustomer")
  liableItems  DefectItemLiableOrganization[]
  proposals    Proposal[]

  @@unique([unp])
  @@index([active, officialName])
  @@map("organizations")
}

model OrganizationRoleAssignment {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  role           OrganizationRoleType
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, role])
  @@map("organization_role_assignments")
}

model WorkType {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  sortOrder  Int
  active     Boolean   @default(true)
  archivedAt DateTime? @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  organizations OrganizationWorkType[]

  @@index([active, sortOrder])
  @@map("work_types")
}

model OrganizationWorkType {
  organizationId String @db.Uuid
  workTypeId     String @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workType     WorkType     @relation(fields: [workTypeId], references: [id], onDelete: Restrict)

  @@id([organizationId, workTypeId])
  @@map("organization_work_types")
}

model DefectType {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  active     Boolean   @default(true)
  archivedAt DateTime? @db.Timestamptz(3)
  version    Int       @default(1)
  sortOrder  Int
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  defectItems DefectItem[]

  @@index([active, sortOrder])
  @@map("defect_types")
}

model Act {
  id                     String      @id @default(uuid()) @db.Uuid
  officialNumber         String      @unique
  formCode               ActFormCode
  year                   Int
  sequence               Int
  objectId               String      @db.Uuid
  customerOrganizationId String      @db.Uuid
  signedDocumentRef      String?
  issuedOn               DateTime    @db.Timestamptz(3)
  status                 ActStatus
  version                Int         @default(1)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(3)
  cancelledAt            DateTime?   @db.Timestamptz(3)
  cancellationReason     String?
  cancelledByUserId      String?     @db.Uuid

  propertyObject PropertyObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  customer       Organization   @relation("ActCustomer", fields: [customerOrganizationId], references: [id], onDelete: Restrict)
  cancelledBy    User?          @relation("ActCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  defectItems    DefectItem[]
  attachments    Attachment[]

  @@unique([formCode, year, sequence])
  @@index([objectId])
  @@index([customerOrganizationId])
  @@map("acts")
}

model ActNumberSequence {
  formCode   ActFormCode
  year       Int
  lastIssued Int

  @@id([formCode, year])
  @@map("act_number_sequences")
}

model DefectItem {
  id                 String           @id @default(uuid()) @db.Uuid
  actId              String           @db.Uuid
  location           String
  defectTypeId       String           @db.Uuid
  status             DefectItemStatus @default(IN_PROGRESS)
  claimDetails       String
  plannedDeadline    DateTime?        @db.Timestamptz(3)
  claimDeadline      DateTime?        @db.Timestamptz(3)
  readyAt            DateTime?        @db.Timestamptz(3)
  thirdPartyDeadline DateTime?        @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  version            Int              @default(1)
  effectiveDeadline  DateTime?        @default(dbgenerated()) @db.Timestamptz(3)

  act                  Act                            @relation(fields: [actId], references: [id], onDelete: Restrict)
  defectType           DefectType                     @relation(fields: [defectTypeId], references: [id], onDelete: Restrict)
  responsibleEngineers DefectItemEngineer[]
  liableOrganizations  DefectItemLiableOrganization[]
  proposals            Proposal[]
  attachments          Attachment[]

  @@index([actId])
  @@index([status])
  @@index([plannedDeadline])
  @@index([claimDeadline])
  @@index([readyAt])
  @@index([effectiveDeadline])
  @@map("defect_items")
}

model DefectItemEngineer {
  defectItemId String @db.Uuid
  userId       String @db.Uuid

  defectItem DefectItem @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([defectItemId, userId])
  @@index([userId])
  @@map("defect_item_engineers")
}

model DefectItemLiableOrganization {
  defectItemId   String @db.Uuid
  organizationId String @db.Uuid

  defectItem   DefectItem   @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([defectItemId, organizationId])
  @@index([organizationId])
  @@map("defect_item_liable_organizations")
}

model Proposal {
  id                                  String         @id @default(uuid()) @db.Uuid
  defectItemId                        String         @db.Uuid
  slot                                ProposalSlot
  alternativeContractorOrganizationId String         @db.Uuid
  amount                              Decimal        @db.Decimal(14, 2)
  currency                            String         @default("BYN")
  status                              ProposalStatus @default(ACTIVE)
  archivedAt                          DateTime?      @db.Timestamptz(3)
  archiveReason                       String?
  version                             Int            @default(1)
  createdAt                           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                           DateTime       @updatedAt @db.Timestamptz(3)

  defectItem            DefectItem   @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  alternativeContractor Organization @relation(fields: [alternativeContractorOrganizationId], references: [id], onDelete: Restrict)
  attachments           Attachment[]

  @@index([defectItemId, slot, status])
  @@map("proposals")
}

model Attachment {
  id               String             @id @default(uuid()) @db.Uuid
  actId            String?            @db.Uuid
  defectItemId     String?            @db.Uuid
  proposalId       String?            @db.Uuid
  originalFilename String
  safeDisplayName  String
  objectKey        String?            @unique
  bucket           String
  sizeBytes        Int
  declaredMimeType String
  detectedMimeType String?
  sha256           String
  category         AttachmentCategory
  status           AttachmentStatus
  uploadedById     String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  uploadedAt       DateTime?          @db.Timestamptz(3)
  scannedAt        DateTime?          @db.Timestamptz(3)
  scanEngine       String?
  scanSignature    String?
  rejectionReason  String?
  archivedAt       DateTime?          @db.Timestamptz(3)
  archivedById     String?            @db.Uuid
  archiveReason    String?
  version          Int                @default(1)
  failureCode      String?

  act        Act?        @relation(fields: [actId], references: [id], onDelete: Restrict)
  defectItem DefectItem? @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  proposal   Proposal?   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  uploadedBy User        @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  archivedBy User?       @relation("AttachmentArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@index([actId, status, createdAt])
  @@index([defectItemId, status, createdAt])
  @@index([proposalId, status, createdAt])
  @@index([uploadedById])
  @@index([sha256])
  @@index([status])
  @@index([createdAt])
  @@map("attachments")
}

model AuditLog {
  id               String      @id @default(uuid()) @db.Uuid
  actorUserId      String?     @db.Uuid
  actorName        String?
  action           String
  entityType       String
  entityId         String
  parentEntityType String?
  parentEntityId   String?
  oldValue         Json?
  newValue         Json?
  reason           String?
  source           AuditSource @default(WEB)
  occurredAt       DateTime    @default(now()) @db.Timestamptz(3)
  ipAddress        String?
  requestId        String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([parentEntityType, parentEntityId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @db.Uuid
  command        String
  idempotencyKey String
  requestHash    String
  statusCode     Int
  responseBody   Json
  resourceId     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, command, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_records")
}

model SystemSettings {
  id                      String   @id @default("default")
  deadlineWarningDays     Int      @default(3)
  maxAttachmentBytes      Int      @default(20971520)
  maxAttachmentsPerOwner  Int      @default(50)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActFormCode {
  S1
  S23
}

enum ActStatus {
  NEW
  IMPORTED_UNSPECIFIED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DefectItemStatus {
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SGR_MANAGER
  RESPONSIBLE_ENGINEER
  CONTRACTOR_ENGINEER
  PENDING_ROLE
  UNASSIGNED
}

enum UserStatus {
  ACTIVE
  ARCHIVED
}

enum OrganizationRoleType {
  CUSTOMER
  LIABLE_CONTRACTOR
  ALTERNATIVE_CONTRACTOR
}

enum ProposalSlot {
  A
  B
  C
}

enum ProposalStatus {
  ACTIVE
  ARCHIVED
}

enum AuditSource {
  WEB
  SYSTEM
}

enum ImportBatchStatus {
  STARTED
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ImportedEngineerResolutionStatus {
  UNMATCHED
  MATCHED
  AMBIGUOUS
  RESOLVED
}

enum AttachmentStatus {
  UPLOADING
  PENDING_SCAN
  SCANNING
  READY
  REJECTED
  SCAN_FAILED
  ARCHIVED
}

enum AttachmentCategory {
  ACT_DOCUMENT
  ACT_SCAN
  DEFECT_PHOTO
  CLAIM_DOCUMENT
  THIRD_PARTY_DOCUMENT
  PROPOSAL_DOCUMENT
  OTHER
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  lastName            String
  firstName           String
  middleName          String?
  fullName            String
  email               String     @unique
  phone               String?
  mustChangePassword  Boolean    @default(false)
  sessionVersion      Int        @default(1)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  role                UserRole
  roleBeforeAdmin     UserRole?
  status              UserStatus @default(ACTIVE)
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime?  @db.Timestamptz(3)

  credentials                    UserCredential?

  objectAssignments              PropertyObjectEngineer[]
  objectEngineerAssignmentsMade  PropertyObjectEngineer[] @relation("ObjectEngineerAssignedBy")
  defectItemAssignments          DefectItemEngineer[]
  cancelledActs         Act[]                    @relation("ActCancelledBy")
  startedActs           Act[]                    @relation("ActStartedBy")
  uploadedAttachments   Attachment[]             @relation("AttachmentUploadedBy")
  archivedAttachments   Attachment[]             @relation("AttachmentArchivedBy")
  auditLogs             AuditLog[]
  idempotencyRecords    IdempotencyRecord[]
  notificationRecipients NotificationRecipient[]
  actChatMessages       ActChatMessage[]
  actChatMentions       ActChatMention[]
  importedEngineerMatches ImportedEngineerReference[] @relation("ImportedEngineerMatchedUser")
  importedEngineerResolutions ImportedEngineerReference[] @relation("ImportedEngineerMatchedBy")

  @@index([role, status])
  @@index([status, createdAt])
  @@index([lastName, firstName, middleName])
  @@map("users")
}

model UserCredential {
  userId            String    @id @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model PropertyObject {
  id                              String    @id @default(uuid()) @db.Uuid
  name                            String
  address                         String?
  commissionedAt                  DateTime? @db.Timestamptz(3)
  warrantyEndsAt                  DateTime? @db.Timestamptz(3)
  sortOrder                       Int       @default(0)
  sourceResponsibleEngineerName   String?
  sourceSystem                    String?
  sourceRow                       Int?
  sourceImportKey                 String?
  createdAt                       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime  @updatedAt @db.Timestamptz(3)
  active                          Boolean   @default(true)
  archivedAt                      DateTime? @db.Timestamptz(3)
  version                         Int       @default(1)

  engineers PropertyObjectEngineer[]
  acts      Act[]

  @@unique([sourceSystem, sourceImportKey], map: "property_objects_source_import_key_unique")
  @@index([active, name])
  @@index([sortOrder, name], map: "property_objects_sort_order_name_idx")
  @@map("property_objects")
}

model PropertyObjectEngineer {
  id               String    @id @default(uuid()) @db.Uuid
  propertyObjectId String    @db.Uuid
  userId           String    @db.Uuid
  assignedAt       DateTime  @default(now()) @db.Timestamptz(3)
  unassignedAt     DateTime? @db.Timestamptz(3)
  assignedByUserId    String?   @db.Uuid
  directoryLinkMethod String?

  propertyObject PropertyObject @relation(fields: [propertyObjectId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedBy     User?          @relation("ObjectEngineerAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([propertyObjectId, userId])
  @@index([userId, propertyObjectId])
  @@map("property_object_engineers")
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  officialName  String
  unp           String?
  postalAddress String?
  email         String?
  phone         String?
  contactPerson String?
  active        Boolean   @default(true)
  archivedAt    DateTime? @db.Timestamptz(3)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  roles        OrganizationRoleAssignment[]
  workTypes    OrganizationWorkType[]
  customerActs Act[]                          @relation("ActCustomer")
  liableItems  DefectItemLiableOrganization[]
  proposals    Proposal[]

  @@unique([unp])
  @@index([active, officialName])
  @@map("organizations")
}

model OrganizationRoleAssignment {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  role           OrganizationRoleType
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, role])
  @@map("organization_role_assignments")
}

model WorkType {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  sortOrder  Int
  active     Boolean   @default(true)
  archivedAt DateTime? @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  organizations OrganizationWorkType[]
  defectItems   DefectItem[]

  @@index([active, sortOrder])
  @@map("work_types")
}

model OrganizationWorkType {
  organizationId String @db.Uuid
  workTypeId     String @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workType     WorkType     @relation(fields: [workTypeId], references: [id], onDelete: Restrict)

  @@id([organizationId, workTypeId])
  @@map("organization_work_types")
}

model DefectType {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  active     Boolean   @default(true)
  archivedAt DateTime? @db.Timestamptz(3)
  version    Int       @default(1)
  sortOrder  Int
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  defectItems DefectItem[]

  @@index([active, sortOrder])
  @@map("defect_types")
}

model Act {
  id                     String      @id @default(uuid()) @db.Uuid
  officialNumber         String?
  formCode               ActFormCode
  year                   Int
  sequence               Int
  objectId               String      @db.Uuid
  customerOrganizationId String      @db.Uuid
  signedDocumentRef      String?
  issuedOn               DateTime    @db.Timestamptz(3)
  status                 ActStatus   @default(NEW)
  version                Int         @default(1)
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(3)
  startedAt              DateTime?   @db.Timestamptz(3)
  startedById            String?     @db.Uuid
  cancelledAt            DateTime?   @db.Timestamptz(3)
  cancellationReason     String?
  cancelledByUserId      String?     @db.Uuid
  sourceSystem           String?
  sourceFileName         String?
  sourceFileSha256       String?
  sourceSheet            String?
  sourceRows             Int[]       @default([])
  sourceExternalUrl      String?
  sourceActNumberRaw     String?
  sourceStatusRaw        String?
  sourceImportKey        String?
  importedAt             DateTime?   @db.Timestamptz(3)
  importBatchId          String?     @db.Uuid

  propertyObject PropertyObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  customer       Organization   @relation("ActCustomer", fields: [customerOrganizationId], references: [id], onDelete: Restrict)
  startedBy      User?          @relation("ActStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  cancelledBy    User?          @relation("ActCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  importBatch    ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  defectItems    DefectItem[]
  attachments    Attachment[]
  notificationEvents NotificationEvent[]
  chatMessages   ActChatMessage[]

  @@unique([formCode, year, sequence])
  @@unique([sourceSystem, sourceImportKey], map: "acts_source_import_key_unique")
  @@index([objectId])
  @@index([customerOrganizationId])
  @@index([status])
  @@index([importBatchId])
  @@map("acts")
}

model ActChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  actId           String   @db.Uuid
  authorId        String   @db.Uuid
  body            String
  clientMessageId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  act      Act              @relation(fields: [actId], references: [id], onDelete: Restrict)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions ActChatMention[]

  @@unique([authorId, clientMessageId])
  @@index([actId, createdAt, id])
  @@map("act_chat_messages")
}

model ActChatMention {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message ActChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
  @@index([userId])
  @@map("act_chat_mentions")
}

model ActNumberSequence {
  formCode   ActFormCode
  year       Int
  lastIssued Int

  @@id([formCode, year])
  @@map("act_number_sequences")
}

model ImportBatch {
  id                     String            @id @default(uuid()) @db.Uuid
  sourceSystem           String
  sourceFileName         String
  sourceFileSha256       String
  sourceSheet            String
  environment            String
  databaseName           String
  status                 ImportBatchStatus
  startedAt              DateTime          @db.Timestamptz(3)
  completedAt            DateTime?         @db.Timestamptz(3)
  createdActs            Int               @default(0)
  createdDefects         Int               @default(0)
  unchangedActs          Int               @default(0)
  unchangedDefects       Int               @default(0)
  createdOrganizations   Int               @default(0)
  createdDefectTypes     Int               @default(0)
  stats                  Json?
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)

  acts        Act[]
  defectItems DefectItem[]
  importedEngineerReferences ImportedEngineerReference[]

  @@index([sourceFileSha256])
  @@index([sourceSystem, startedAt])
  @@map("import_batches")
}

model DefectItem {
  id                 String           @id @default(uuid()) @db.Uuid
  actId              String           @db.Uuid
  location           String?
  defectTypeId       String           @db.Uuid
  workTypeId         String?          @db.Uuid
  status             DefectItemStatus @default(IN_PROGRESS)
  claimDetails       String?
  plannedDeadline    DateTime?        @db.Timestamptz(3)
  claimDeadline      DateTime?        @db.Timestamptz(3)
  readyAt            DateTime?        @db.Timestamptz(3)
  thirdPartyDeadline DateTime?        @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  version            Int              @default(1)
  effectiveDeadline  DateTime?        @default(dbgenerated()) @db.Timestamptz(3)
  sourceSystem       String?
  sourceFileName     String?
  sourceFileSha256   String?
  sourceSheet        String?
  sourceRows         Int[]            @default([])
  sourceDeadlineRaw  String?
  sourceImportKey    String?
  importedAt         DateTime?        @db.Timestamptz(3)
  importBatchId      String?          @db.Uuid

  act                  Act                            @relation(fields: [actId], references: [id], onDelete: Restrict)
  defectType           DefectType                     @relation(fields: [defectTypeId], references: [id], onDelete: Restrict)
  workType             WorkType?                      @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  importBatch          ImportBatch?                   @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  responsibleEngineers DefectItemEngineer[]
  liableOrganizations  DefectItemLiableOrganization[]
  proposals            Proposal[]
  attachments          Attachment[]
  slaClocks            SlaClock[]
  notificationEvents   NotificationEvent[]
  importedEngineerReferences ImportedEngineerReference[]

  @@index([actId])
  @@index([status])
  @@index([workTypeId])
  @@index([plannedDeadline])
  @@index([claimDeadline])
  @@index([readyAt])
  @@index([effectiveDeadline])
  @@index([importBatchId])
  @@unique([sourceSystem, sourceImportKey], map: "defect_items_source_import_key_unique")
  @@map("defect_items")
}

model DefectItemEngineer {
  defectItemId String @db.Uuid
  userId       String @db.Uuid

  defectItem DefectItem @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([defectItemId, userId])
  @@index([userId])
  @@map("defect_item_engineers")
}

model ImportedEngineerReference {
  id                 String                             @id @default(uuid()) @db.Uuid
  defectItemId       String                             @db.Uuid
  importBatchId      String                             @db.Uuid
  sourceNameRaw      String
  nameMatchKey       String
  normalizedSurname  String
  firstInitial       String
  middleInitial      String?
  resolutionStatus   ImportedEngineerResolutionStatus
  matchedUserId      String?                            @db.Uuid
  matchedAt          DateTime?                          @db.Timestamptz(3)
  matchedByUserId    String?                            @db.Uuid
  createdAt          DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                           @updatedAt @db.Timestamptz(3)

  defectItem    DefectItem  @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  matchedUser   User?       @relation("ImportedEngineerMatchedUser", fields: [matchedUserId], references: [id], onDelete: SetNull)
  matchedByUser User?       @relation("ImportedEngineerMatchedBy", fields: [matchedByUserId], references: [id], onDelete: SetNull)

  @@unique([defectItemId, nameMatchKey], map: "imported_engineer_refs_defect_key_unique")
  @@index([importBatchId])
  @@index([resolutionStatus])
  @@index([matchedUserId])
  @@map("imported_engineer_references")
}

model DefectItemLiableOrganization {
  defectItemId   String @db.Uuid
  organizationId String @db.Uuid

  defectItem   DefectItem   @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([defectItemId, organizationId])
  @@index([organizationId])
  @@map("defect_item_liable_organizations")
}

model Proposal {
  id                                  String         @id @default(uuid()) @db.Uuid
  defectItemId                        String         @db.Uuid
  slot                                ProposalSlot
  alternativeContractorOrganizationId String         @db.Uuid
  amount                              Decimal        @db.Decimal(14, 2)
  currency                            String         @default("BYN")
  status                              ProposalStatus @default(ACTIVE)
  archivedAt                          DateTime?      @db.Timestamptz(3)
  archiveReason                       String?
  version                             Int            @default(1)
  createdAt                           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                           DateTime       @updatedAt @db.Timestamptz(3)

  defectItem            DefectItem   @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  alternativeContractor Organization @relation(fields: [alternativeContractorOrganizationId], references: [id], onDelete: Restrict)
  attachments           Attachment[]

  @@index([defectItemId, slot, status])
  @@map("proposals")
}

model Attachment {
  id               String             @id @default(uuid()) @db.Uuid
  actId            String?            @db.Uuid
  defectItemId     String?            @db.Uuid
  proposalId       String?            @db.Uuid
  originalFilename String
  safeDisplayName  String
  objectKey        String?            @unique
  bucket           String
  sizeBytes        Int
  declaredMimeType String
  detectedMimeType String?
  sha256           String
  category         AttachmentCategory
  status           AttachmentStatus
  uploadedById     String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  uploadedAt       DateTime?          @db.Timestamptz(3)
  scannedAt        DateTime?          @db.Timestamptz(3)
  scanEngine       String?
  scanSignature    String?
  rejectionReason  String?
  archivedAt       DateTime?          @db.Timestamptz(3)
  archivedById     String?            @db.Uuid
  archiveReason    String?
  version          Int                @default(1)
  failureCode      String?

  act        Act?        @relation(fields: [actId], references: [id], onDelete: Restrict)
  defectItem DefectItem? @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  proposal   Proposal?   @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  uploadedBy User        @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  archivedBy User?       @relation("AttachmentArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@index([actId, status, createdAt])
  @@index([defectItemId, status, createdAt])
  @@index([proposalId, status, createdAt])
  @@index([uploadedById])
  @@index([sha256])
  @@index([status])
  @@index([createdAt])
  @@map("attachments")
}

model AuditLog {
  id               String      @id @default(uuid()) @db.Uuid
  actorUserId      String?     @db.Uuid
  actorName        String?
  action           String
  entityType       String
  entityId         String
  parentEntityType String?
  parentEntityId   String?
  oldValue         Json?
  newValue         Json?
  reason           String?
  source           AuditSource @default(WEB)
  occurredAt       DateTime    @default(now()) @db.Timestamptz(3)
  ipAddress        String?
  requestId        String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([parentEntityType, parentEntityId, occurredAt])
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @db.Uuid
  command        String
  idempotencyKey String
  requestHash    String
  statusCode     Int
  responseBody   Json
  resourceId     String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, command, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_records")
}

model SystemSettings {
  id                         String   @id @default("default")
  deadlineWarningDays        Int      @default(3)
  maxAttachmentBytes         Int      @default(20971520)
  maxAttachmentsPerOwner     Int      @default(50)
  escalationDays             Int[]    @default([0, 3, 7, 14])
  dailyEvaluationMinuteOfDay Int      @default(480)
  emailEnabled               Boolean  @default(true)
  version                    Int      @default(1)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}

enum SlaClockKind {
  GENERAL
  THIRD_PARTY
}

enum SlaClockState {
  NO_DEADLINE
  NORMAL
  WARNING
  DUE_TODAY
  OVERDUE
  COMPLETED
}

enum OutboxStatus {
  PENDING
  CLAIMED
  PROCESSED
  FAILED
  DEAD
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
}

model SlaClock {
  id                        String        @id @default(uuid()) @db.Uuid
  defectItemId              String        @db.Uuid
  kind                      SlaClockKind
  deadline                  DateTime?     @db.Timestamptz(3)
  cycle                     Int           @default(1)
  state                     SlaClockState
  lastEvaluatedBusinessDate String?
  satisfiedAt               DateTime?     @db.Timestamptz(3)
  version                   Int           @default(1)
  createdAt                 DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @db.Timestamptz(3)

  defectItem DefectItem @relation(fields: [defectItemId], references: [id], onDelete: Restrict)

  @@unique([defectItemId, kind])
  @@index([kind, state, deadline])
  @@index([lastEvaluatedBusinessDate])
  @@map("sla_clocks")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  attempts      Int          @default(0)
  claimedAt     DateTime?    @db.Timestamptz(3)
  claimedBy     String?
  processedAt   DateTime?    @db.Timestamptz(3)
  lastErrorCode String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

model NotificationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  type           String
  occurrenceKey  String   @unique
  actorUserId    String?  @db.Uuid
  actId          String?  @db.Uuid
  defectItemId   String?  @db.Uuid
  attachmentId   String?  @db.Uuid
  payload        Json
  occurredAt     DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  recipients NotificationRecipient[]
  defectItem DefectItem? @relation(fields: [defectItemId], references: [id], onDelete: Restrict)
  act        Act?        @relation(fields: [actId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actId, occurredAt])
  @@index([defectItemId])
  @@map("notification_events")
}

model NotificationRecipient {
  id                   String    @id @default(uuid()) @db.Uuid
  notificationEventId  String    @db.Uuid
  userId               String    @db.Uuid
  readAt               DateTime? @db.Timestamptz(3)
  archivedAt           DateTime? @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  event           NotificationEvent @relation(fields: [notificationEventId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailDeliveries EmailDelivery[]

  @@unique([notificationEventId, userId])
  @@index([userId, readAt, createdAt])
  @@index([userId, revokedAt, createdAt])
  @@map("notification_recipients")
}

model EmailDelivery {
  id                       String              @id @default(uuid()) @db.Uuid
  notificationRecipientId  String              @db.Uuid
  status                   EmailDeliveryStatus @default(QUEUED)
  attempts                 Int                 @default(0)
  nextAttemptAt            DateTime            @default(now()) @db.Timestamptz(3)
  sentAt                   DateTime?           @db.Timestamptz(3)
  providerMessageId        String?
  lastErrorCode            String?
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)

  recipient NotificationRecipient @relation(fields: [notificationRecipientId], references: [id], onDelete: Restrict)

  @@unique([notificationRecipientId])
  @@index([status, nextAttemptAt])
  @@map("email_deliveries")
}

model SlaEvaluationState {
  id                         String    @id @default("default")
  lastSuccessfulBusinessDate String?
  lastRunAt                  DateTime? @db.Timestamptz(3)
  lastStatus                 String?
  lastErrorCode              String?
  createdAt                  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @db.Timestamptz(3)

  @@map("sla_evaluation_state")
}

{
  "name": "@sgr-registry/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:registry:performance": "tsx scripts/registry-performance.ts",
    "test:sla:performance": "tsx scripts/sla-performance.ts",
    "roles:provision": "tsx scripts/provision-roles.ts",
    "super-admin:provision": "tsx scripts/provision-super-admin.ts",
    "objects:import": "tsx scripts/import-property-objects.ts",
    "acts:import": "tsx scripts/import-legacy-acts.ts",
    "directories:import": "tsx scripts/import-directories.ts",
    "objects:reconcile-engineers": "tsx scripts/reconcile-object-engineers.ts",
    "isolation:verify": "tsx scripts/verify-isolation-hardening.ts",
    "verify:act-start": "tsx scripts/verify-act-start-migration.ts",
    "verify:objects-directory": "tsx scripts/verify-objects-directory-migration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sgr-registry/domain": "workspace:*",
    "argon2": "^0.44.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@sgr-registry/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

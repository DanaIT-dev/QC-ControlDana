# Local development only. Copy to `.env` and never commit real secrets.
NODE_ENV=development

# Web
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API / worker
API_HOST=0.0.0.0
API_PORT=3001

# PostgreSQL (docker compose)
POSTGRES_USER=sgr_registry
POSTGRES_PASSWORD=sgr_registry_dev_password
POSTGRES_DB=sgr_registry
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sgr_registry:sgr_registry_dev_password@localhost:5432/sgr_registry?schema=public

# Dedicated test database. Integration tests refuse any URL whose database name
# does not end with `_test`.
TEST_DATABASE_URL=postgresql://sgr_registry:sgr_registry_dev_password@localhost:5432/sgr_registry_test?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible local storage)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sgr_minio_admin
S3_SECRET_KEY=sgr_minio_dev_password
S3_BUCKET=sgr-attachments
S3_FORCE_PATH_STYLE=true

# Local-only demo password for development and test seed. Never use this value in production.
SEED_DEMO_PASSWORD=Dana-SGR-Demo-2026!

# Auth / sessions
TRUST_PROXY=false
SESSION_TTL_SECONDS=2592000
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
REDIS_KEY_PREFIX=sgr
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
BUSINESS_TIME_ZONE=Europe/Minsk

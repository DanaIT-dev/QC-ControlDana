# Local development only. Copy to `.env` and never commit real secrets.
NODE_ENV=development

# Web
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API / worker
API_HOST=0.0.0.0
API_PORT=3001
WORKER_HEALTH_PORT=3002
WORKER_READY_TIMEOUT_MS=10000

# PostgreSQL (docker compose bootstrap superuser — never a runtime URL)
POSTGRES_USER=sgr_registry
POSTGRES_PASSWORD=sgr_registry_dev_password
POSTGRES_DB=sgr_registry
POSTGRES_PORT=5432
POSTGRES_ADMIN_URL=postgresql://sgr_registry:sgr_registry_dev_password@localhost:5432/sgr_registry

# Runtime and migrator roles (local fictional passwords). Provision with: pnpm db:roles:provision
DATABASE_URL=postgresql://sgr_app_user:sgr_app_dev_password@localhost:5432/sgr_registry?schema=public
AUTH_DATABASE_URL=postgresql://sgr_auth_user:sgr_auth_dev_password@localhost:5432/sgr_registry?schema=public
WORKER_DATABASE_URL=postgresql://sgr_worker_user:sgr_worker_dev_password@localhost:5432/sgr_registry?schema=public
MIGRATION_DATABASE_URL=postgresql://sgr_migrator:sgr_migrator_dev_password@localhost:5432/sgr_registry?schema=public
RLS_CONTEXT_SECRET=local-dev-rls-hmac-secret-not-for-production

# Dedicated test database. Integration tests refuse any URL whose database name
# does not end with `_test`. Role URLs are remapped onto this database name.
TEST_DATABASE_URL=postgresql://sgr_registry:sgr_registry_dev_password@localhost:5432/sgr_registry_test?schema=public

# Dedicated Playwright database. Never sgr_registry, never *_test, never production.
# `pnpm test:e2e` remaps runtime/migrator URLs onto this name, Redis DB 14 / prefix sgr-e2e,
# MinIO bucket sgr-attachments-e2e, and loopback ports 3200/3201/3202.
E2E_DATABASE_URL=postgresql://sgr_registry:sgr_registry_dev_password@localhost:5432/sgr_registry_e2e?schema=public
E2E_MIGRATION_DATABASE_URL=postgresql://sgr_migrator:sgr_migrator_dev_password@localhost:5432/sgr_registry_e2e?schema=public
E2E_AUTH_DATABASE_URL=postgresql://sgr_auth_user:sgr_auth_dev_password@localhost:5432/sgr_registry_e2e?schema=public
E2E_WORKER_DATABASE_URL=postgresql://sgr_worker_user:sgr_worker_dev_password@localhost:5432/sgr_registry_e2e?schema=public
E2E_S3_BUCKET=sgr-attachments-e2e

# Redis. Local compose requires AUTH. This password is fictional and must never be used in production.
REDIS_PORT=6379
REDIS_PASSWORD=local-development-only
REDIS_API_PASSWORD=local-development-only
REDIS_WORKER_PASSWORD=local-development-only
REDIS_URL=redis://sgr_api:local-development-only@127.0.0.1:6379/0
WORKER_REDIS_URL=redis://sgr_worker:local-development-only@127.0.0.1:6379/0

# MinIO (S3-compatible local storage)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sgr_minio_admin
S3_SECRET_KEY=sgr_minio_dev_password
S3_BUCKET=sgr-attachments
S3_TEST_BUCKET=sgr-attachments-test
S3_FORCE_PATH_STYLE=true

# ClamAV (host-run API/worker talk to published localhost port)
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_PER_OWNER=50
ATTACHMENT_MAX_PIXELS=40000000
ATTACHMENT_SCAN_MAX_ATTEMPTS=3

# Local-only demo password for development and test seed. Never use this value in production.
SEED_DEMO_PASSWORD=Dana-SGR-Demo-2026!

# Auth / sessions
TRUST_PROXY=false
SESSION_IDLE_TIMEOUT_SECONDS=43200
SESSION_ABSOLUTE_LIFETIME_SECONDS=604800
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=25
AUTH_LOGIN_WINDOW_SECONDS=900
REDIS_KEY_PREFIX=sgr
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
BUSINESS_TIME_ZONE=Europe/Minsk

# Local Mailpit only. Production SMTP is configured via environment, never committed.
EMAIL_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=8000
EMAIL_FROM=sgr-registry@localhost
PUBLIC_APP_URL=http://localhost:3000
MAILPIT_API_URL=http://127.0.0.1:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

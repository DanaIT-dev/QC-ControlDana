# Copy to the deployment host as infra/docker/secrets/app.env.
# Leave no real secrets in Git. Empty or development values must fail startup.

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=https://registry.example.internal
PUBLIC_APP_URL=https://registry.example.internal
NEXT_PUBLIC_API_URL=https://registry.example.internal

DATABASE_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
RLS_CONTEXT_SECRET=

REDIS_URL=
WORKER_REDIS_URL=

S3_ENDPOINT=http://object-storage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=sgr-attachments
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

CLAMD_HOST=clamav
CLAMD_PORT=3310
ATTACHMENT_MAX_BYTES=20971520

TRUST_PROXY=true
SESSION_IDLE_TIMEOUT_SECONDS=43200
SESSION_ABSOLUTE_LIFETIME_SECONDS=604800
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Operator host only. Do not place the backup key in the API container or next to backups.
BACKUP_ROOT=
BACKUP_ENCRYPTION_KEY_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
SGR_TLS_DOMAIN=
SGR_IMAGE_TAG=
SGR_RUNTIME_IMAGE_DIGEST=
SGR_WEB_IMAGE_DIGEST=
SGR_MIGRATOR_IMAGE_DIGEST=
SGR_PLATFORM=linux/amd64
